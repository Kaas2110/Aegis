    {"id":"dire_meta_score","group":"prematch_hero","label_ru":"Мета-скор Dire","shortHint_ru":"Σ pro_pickrate 5 героев Dire","longDescription_ru":"См. radiant_meta_score.","computedBy":"buildHeroFeatures","sourceTables":["hero_stats","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":0,"rangeMax":3,"nullable":true,"unit":""},
    {"id":"ban_priority_diff","group":"prematch_hero","label_ru":"Разница приоритета банов","shortHint_ru":"Σ pro_pickrate банов R − D","longDescription_ru":"Какая из команд банила более «топовых» по pickrate героев. Прокси на «кто диктовал draft phase».","computedBy":"buildHeroFeatures","sourceTables":["hero_stats","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":-2,"rangeMax":2,"nullable":true,"unit":""},
    {"id":"synergy_diff","group":"prematch_hero","label_ru":"Разница синергий героев в команде","shortHint_ru":"Σ pairwise synergy 10 пар Radiant − 10 пар Dire","longDescription_ru":"Внутри каждой команды (5 героев) 10 уникальных пар. Каждой паре скор (synergyWR − 0.5)·log(games+1) из hero_synergy. Разница A − B.","computedBy":"buildHeroFeatures (T0 mini-fix)","sourceTables":["hero_synergy","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":-3,"rangeMax":3,"nullable":true,"unit":""},
    {"id":"early_game_score_diff","group":"prematch_hero","label_ru":"Разница раннего скейлинга","shortHint_ru":"Σ early_score героев R − D","longDescription_ru":"Сумма early_game_score из hero_stats (как сильно герой давит на лейне в первые 10 мин). Дефолт 0.5 если null.","computedBy":"buildHeroFeatures","sourceTables":["hero_stats"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":-2,"rangeMax":2,"nullable":true,"unit":""},
    {"id":"late_game_score_diff","group":"prematch_hero","label_ru":"Разница позднего скейлинга","shortHint_ru":"Σ late_score героев R − D","longDescription_ru":"Сумма late_game_score из hero_stats. Положительное → Radiant сильнее в late game; шанс выиграть зависит от того, успеет ли поздняя сторона дожить до своего скейла.","computedBy":"buildHeroFeatures","sourceTables":["hero_stats"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":-2,"rangeMax":2,"nullable":true,"unit":""},
    {"id":"counter_bans_diff","group":"prematch_hero","label_ru":"Разница защитных банов","shortHint_ru":"Сумма advantage где бан помогает против нашего пика","longDescription_ru":"Для каждого бана команды смотрим: если забаненный герой имел winrate против наших пиков > 0.5 (т.е. был бы контр-пиком), то бан «защитный». Сумма adv·log(games+1).","computedBy":"buildHeroFeatures (T0 mini-fix v2)","sourceTables":["hero_matchups","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v2","v3"],"valueType":"number","rangeMin":-3,"rangeMax":3,"nullable":true,"unit":""},

    {"id":"player_skill_diff","group":"prematch_extra","label_ru":"Скил игроков на пикнутых героях","shortHint_ru":"Σ (playerWR_на_герое − globalWR_героя)·log(games+1)","longDescription_ru":"Для каждого игрока команды смотрим его личный винрейт на пикнутом герое (player_hero_stats, ≥7d свежесть). Сравниваем с глобальным проф-винрейтом героя. Положительное → игрок умеет этого героя лучше среднего профи.","computedBy":"buildExtraFeatures (Wave3)","sourceTables":["player_hero_stats","hero_stats","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v3"],"valueType":"number","rangeMin":-5,"rangeMax":5,"nullable":false,"unit":""},
    {"id":"recent_form_diff","group":"prematch_extra","label_ru":"Разница 30-дневной формы","shortHint_ru":"team_winrate_30d_R − team_winrate_30d_D","longDescription_ru":"Winrate команды за последние 30 дней по pro-матчам. При <5 играх — дефолт 0.5.","computedBy":"compute:recent-form","sourceTables":["team_recent_form"],"engines":["logreg","lightgbm"],"usedInBuckets":["v3"],"valueType":"number","rangeMin":-0.5,"rangeMax":0.5,"nullable":false,"unit":""},
    {"id":"h2h_advantage_radiant","group":"prematch_extra","label_ru":"H2H преимущество за 365d","shortHint_ru":"(wr_R_vs_D − 0.5)·log(games+1)","longDescription_ru":"Голова-к-голове между конкретно этими двумя командами за 365 дней. При <3 встреч — фича = 0.","computedBy":"compute:h2h","sourceTables":["team_h2h"],"engines":["logreg","lightgbm"],"usedInBuckets":["v3"],"valueType":"number","rangeMin":-3,"rangeMax":3,"nullable":false,"unit":""},
    {"id":"side_advantage","group":"prematch_extra","label_ru":"Сторонний бонус (placeholder)","shortHint_ru":"Всегда 1 (исторический артефакт)","longDescription_ru":"Константа 1. Оставлена для совместимости с обученными моделями v3. Эффективно работает как второй bias для Wave3 блока.","computedBy":"константа","sourceTables":[],"engines":["logreg","lightgbm"],"usedInBuckets":["v3"],"valueType":"number","rangeMin":1,"rangeMax":1,"nullable":false,"unit":""},
    {"id":"player_glicko_diff","group":"prematch_extra","label_ru":"Glicko-1 разница ростеров","shortHint_ru":"(avgGlicko_R − avgGlicko_D) / 200","longDescription_ru":"Glicko-1 рейтинг игрока (как Elo, но с учётом давности игр). Усредняем по 5 игрокам ростера, берём разницу, делим на 200 (типичный шаг Glicko). Дефолт 1500 если игрок не найден.","computedBy":"compute:player-glicko","sourceTables":["player_ratings","match_drafts"],"engines":["logreg","lightgbm"],"usedInBuckets":["v3"],"valueType":"number","rangeMin":-3,"rangeMax":3,"nullable":false,"unit":""},
