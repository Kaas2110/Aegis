    {"id":"live.bias","group":"live_winner","label_ru":"Bias-константа (live)","shortHint_ru":"Всегда 1","longDescription_ru":"См. bias в prematch.","computedBy":"-","sourceTables":[],"engines":["logreg"],"usedInBuckets":["live-winner-v8"],"valueType":"number","rangeMin":1,"rangeMax":1,"nullable":false,"unit":""},
    {"id":"live.game_time_norm","group":"live_winner","label_ru":"Минута матча (нормированная)","shortHint_ru":"(gameTimeSec − 1800) / 1800","longDescription_ru":"Центрировано к 30-й минуте. На минуте 0 = -1, на 60-й = +1. Учим модель что ранние снапшоты менее предсказуемы.","computedBy":"live snapshot","sourceTables":["live_snapshots"],"engines":["logreg"],"usedInBuckets":["live-winner-v8"],"valueType":"number","rangeMin":-1,"rangeMax":1,"nullable":false,"unit":"normalized min"},
