# ═══════════════════════════════════════════════════════════════════════════
# Aegis — шаблон переменных окружения (.env)
# Скопируйте в .env рядом с корнем репо и заполните значения.
# ⚠️ НИКОГДА не коммитьте настоящий .env в git (.gitignore уже настроен).
# Значения секретов с Replit: Workspace → Tools → Secrets (скопировать вручную).
# ═══════════════════════════════════════════════════════════════════════════

# ── ОБЯЗАТЕЛЬНЫЕ ────────────────────────────────────────────────────────────

# PostgreSQL. Локальный пример: postgres://aegis:пароль@127.0.0.1:5432/aegis
DATABASE_URL=

# HMAC-секрет для admin-сессий и user-auth токенов. Минимум 32 случайных
# символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ── АДМИНКА ─────────────────────────────────────────────────────────────────

# Пароль входа в админку (/admin-web). Высокоэнтропийная строка:
# openssl rand -hex 24
ADMIN_TOKEN=

# ── ВНЕШНИЕ ИСТОЧНИКИ ДАННЫХ (опциональные, но крайне желательные) ──────────

# Stratz JWT (бесплатно): stratz.com/api → вход через Steam → My Account → API.
# Можно НЕСКОЛЬКО токенов через запятую (пул: лимиты 250 req/min / 20k/day
# суммируются): STRATZ_TOKEN=tok1,tok2,tok3
STRATZ_TOKEN=

# PandaScore (бесплатный tier): pandascore.co → Dashboard → API token.
# Нужен для расписания upcoming-матчей.
PANDASCORE_API_KEY=

# OpenDota: БЕЗ ключа работает FREE MODE (60 req/min, 3000 req/day,
# троттл 1100ms — уже учтено в скриптах). Premium ($ подписка opendota.com)
# включается ТОЛЬКО ПАРОЙ переменных:
#OPENDOTA_USE_PREMIUM=true
OPENDOTA_API_KEY=

# ── БУКМЕКЕРЫ (опционально) ─────────────────────────────────────────────────

# Мастер-выключатель букмекерского пайплайна (default true)
BOOKMAKERS_ENABLED=true

# Прокси для РФ-букмекеров, если сервер стоит НЕ на РФ-IP.
# Формат: http://user:pass@host:port
#PROXY_URL=

# The Odds API (пока не используем — решение «не платить на этом этапе»)
#ODDS_API_KEY=

# Pinnacle guest key (нет в наличии; Bovada работает без ключа)
#PINNACLE_GUEST_API_KEY=

# ── ML-СЕРВИС ───────────────────────────────────────────────────────────────

# URL Python ml-service (LightGBM). Default http://localhost:8090
#ML_SERVICE_URL=http://localhost:8090

# Общий токен api-server ↔ ml-service. Если не задан, ml-service сгенерирует
# ephemeral и запишет в /tmp/aegis_ml_token (оба процесса на одной машине — ок).
# Для systemd-запуска задайте явно: openssl rand -hex 16
#ML_SERVICE_TOKEN=

# Таймаут predict-запросов к ml-service, мс (default 1500)
#ML_PREDICT_TIMEOUT_MS=1500

# ── ВОРКЕРЫ / ПЛАНИРОВЩИК ───────────────────────────────────────────────────

# In-process воркеры api-server (default оба включены):
#DISABLE_LIVE_WORKER=false
#DISABLE_SCHEDULER=false

# Auto-retrain: на Replit — true (killswitch), на ноуте — false + окно часа:
DISABLE_AUTO_RETRAIN=false
# Обучение разрешено ТОЛЬКО в этот час UTC (4 = ~07:00 МСК, тихий час):
AUTO_RETRAIN_CRON_HOUR_UTC=4

# ── ПРОЧЕЕ (обычно трогать не нужно) ────────────────────────────────────────

# Порт api-server (default 8080)
#PORT=8080

# Отключить авто-push схемы БД при старте api-server (default push включён)
#AUTO_DB_PUSH=false

# Минимальный рейтинг команд для показа матчей (фильтр мусорных лиг)
#MIN_TEAM_RATING=

# Уровень логов pino: trace|debug|info|warn|error (default info)
#LOG_LEVEL=info

# production в проде — влияет на secure-флаг cookie и формат логов
NODE_ENV=production

# ── МОБИЛКА (build-time, задаются при сборке EAS/Expo, НЕ в .env сервера) ───
# EXPO_PUBLIC_API_URL   — прод-URL API, например https://api.вашдомен.ru
# EXPO_PUBLIC_PAYMENT_CHANNEL — rustore (уже в eas.json production-android)
