# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# ── Обязательно ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis
ADMIN_TOKEN=замени-на-длинную-случайную-строку-минимум-32-символа
SESSION_SECRET=замени-на-другую-длинную-случайную-строку

# ── Опционально: внешние API ──────────────────────────────────────────────────
# STRATZ_TOKEN=           # JWT с stratz.com/api (Steam логин), 20k req/day бесплатно
# PANDASCORE_API_KEY=     # PandaScore API key

# ── Опционально: ЮКасса (для RuStore-биллинга) ───────────────────────────────
# YOOKASSA_SHOP_ID=       # Номер магазина (цифры)
# YOOKASSA_SECRET_KEY=    # Секретный ключ (live_...)

# ── Опционально: тонкая настройка ────────────────────────────────────────────
# DISABLE_SCHEDULER=false         # Выключить авто-ретрейн и сбор данных
# DISABLE_LIVE_WORKER=false       # Выключить live-прогнозы
# DISABLE_AUTO_RETRAIN=false      # Только ретрейн, без расписания
# AUTO_DB_PUSH=true               # Авто-миграция БД при старте (default: true)
# POLL_UPCOMING_MIN=30            # Как часто обновлять предстоящие матчи
# PROXY_URL=                      # HTTP-прокси для букмекеров (нужен RU IP)
