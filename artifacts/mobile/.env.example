# Public API server address embedded by Expo when this app is built.
# Web: leave empty for the same origin as the website.
# Native Android/iOS: set explicitly; an empty value disables network requests.
EXPO_PUBLIC_API_URL=

# USB test build only, with adb reverse tcp:8080 tcp:8080:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8080

# Store build: use your deployed HTTPS server, for example:
# EXPO_PUBLIC_API_URL=https://your-aegis-server.example
# Set this in the build environment or artifacts/mobile/.env.local, then rebuild.
# Both an origin and a trailing /api are accepted; credentials/query/fragment
# and arbitrary base paths are rejected. No local server is selected implicitly.
# Never place tokens, private provider keys, ADMIN_TOKEN or SESSION_SECRET here.
