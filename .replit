modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/ml-service: ML Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Data Enrichment"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Drafts Backfill 365d"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Replay Parse Loop"

[[workflows.workflow]]
name = "artifacts/ml-service: ML Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ml-service run dev"
waitForPort = 8090

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Data Enrichment"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-enrichment-pipeline.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Drafts Backfill 365d"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-drafts-backfill.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Replay Parse Loop"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-replay-parse-loop.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8090
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 4200

[[ports]]
localPort = 24276
externalPort = 3002

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ML_SERVICE_TOKEN = "ag2k_Rupz3kQYk9CpzNp50-WLRudv4YeqZDdXOCSMQo"
